# apps/hq-mcp — TheIceJi HQ MCP server (projects × modules).
#
# Local: copy to .env. On Railway, set these as service variables instead —
# nothing copies a .env into the image (see .dockerignore).

# ── HQ Postgres — the same database apps/hq migrates ──────────────────────
# Every request's bearer token is checked against it (never cached, so a
# connection revoked in HQ → Connections stops on its next call).
# Managed hosts want TLS:  postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
# DATABASE_POOL_MAX=5

# ── Identity ───────────────────────────────────────────────────────────────
# The public MCP endpoint — exactly what gets pasted into Claude / ChatGPT,
# path included, no trailing slash. It must also be listed in HQ's
# MCP_RESOURCE_URLS or HQ refuses to issue tokens for it. Choose it once per
# environment: changing it strands every existing connection.
#   prod    https://mcp.example.com/mcp
#   local   http://localhost:8991/mcp
MCP_PUBLIC_URL=http://localhost:8991/mcp

# The authorization server — HQ's origin, identical to HQ's OAUTH_ISSUER.
#   prod    https://hq.example.com
#   local   http://localhost:8990
MCP_AUTHORIZATION_SERVER=http://localhost:8990

# Optional: advertised as resource_documentation.
# MCP_DOCUMENTATION_URL=https://hq.example.com/settings/connections

# Browser origins allowed to call the endpoint (hostnames, comma-separated) —
# e.g. `localhost` for the MCP Inspector. Leave empty otherwise: Claude,
# ChatGPT and agents send no Origin header and always pass.
MCP_ALLOWED_ORIGIN_HOSTS=

# MCP_MAX_REQUEST_BYTES=4194304

# Reverse proxies in front of this process that append to X-Forwarded-For. The
# per-address rate budgets key on the entry this many hops from the right; 0
# ignores the header and uses the socket address. Railway's edge is one hop.
#   MCP_TRUSTED_PROXY_HOPS=1   (Railway)
# MCP_TRUSTED_PROXY_HOPS=0
# PORT=8991        # Railway injects PORT
# HOST=0.0.0.0

# ── HQ modules ────────────────────────────────────────────────────────────
# Seconds between ops ticks run by this process (@theiceji/hq-ops): lapsed
# leases, expiries, stalled runs, every module's registered steps, event
# delivery. A lease row keeps it to one tick at a time across replicas and
# HQ's cron. 0 turns it off here. (The legacy name
# CREATOR_SCHEDULER_SECONDS is still read when this one is unset.)
# HQ_SCHEDULER_SECONDS=60
#
# 32 random bytes, base64 — the SAME value as apps/hq. Seals provider
# credentials and runtime signing secrets; without it event delivery to a
# runtime's URL can't be signed (pull-based runtimes still work).
#   openssl rand -base64 32
# Older deployments set it under its legacy name,
# CREATOR_SEALING_KEY, which is read when HQ_SEALING_KEY is unset — keep
# whichever name the environment already uses.
HQ_SEALING_KEY=
#
# Asset uploads/downloads for assets_prepare_upload and friends — the same R2
# bucket and token as apps/hq. Unset → those tools answer
# capability_unavailable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
#
# Local stdio only: the HQ user every tool acts as (they refuse without one).
# HQ_LOCAL_USER_EMAIL=
