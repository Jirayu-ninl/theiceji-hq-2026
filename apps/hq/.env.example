# Copy to .env.local and fill in.

# --- Postgres (auth, projects and their modules, and push subscriptions) ---
# Any Postgres 13+ will do — Neon, RDS, a VPS, or `postgres` running locally.
# Include sslmode in the URL when the host wants TLS (managed ones all do):
#   postgres://user:pass@host:5432/hq?sslmode=require
# Apply the schema with `bun run db:migrate`, then make your first login with
# `bun run user:create`. Unset → HQ boots and shows "not configured".
DATABASE_URL=
# Connections per instance (default 4). A page reads a dozen things at once;
# with 1 they queue. Keep instances × this, plus hq-mcp's pool and the agent
# runner's 4, under the database's connection limit.
# DATABASE_POOL_MAX=4
# Queries run as prepared statements: one round trip each instead of two.
# Set false only when DATABASE_URL goes through a transaction-mode pooler
# (pgbouncer, a "pooled" URL), which loses them between queries.
# DATABASE_PREPARE=true
# Only needed when the runtime role above is deliberately locked down:
# migrating creates schemas and tables, serving does not. `bun run db:migrate`
# prefers this URL; `bun run db:check` reports both.
# DATABASE_MIGRATE_URL=

# --- Web Push (devices registered here) ---
# HQ owns the device list — Settings › Account subscribes this browser, and
# the ops tick pushes to it when an urgent request is waiting for you.
# Generate a keypair once:  npx web-push generate-vapid-keys
# PUBLIC must be mirrored to NEXT_PUBLIC_VAPID_PUBLIC_KEY (the toggle reads it
# client-side). SUBJECT is a mailto: contact for the push services.
# Unset → push is silently skipped; everything else works unchanged.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Cron (daily database keep-alive + ops tick backstop) ---
# Vercel Cron calls /api/cron/db-ping once a day (schedule in vercel.json) so a
# managed Postgres never idles long enough to suspend/pause, and
# /api/cron/ops-tick once a day as a backstop for the ops tick apps/hq-mcp
# runs every minute (the cron also sends the push for urgent requests). The
# same secret unlocks the detailed /api/ready report for a monitor. Vercel sends
# `Authorization: Bearer <CRON_SECRET>` automatically when this is set on the
# project. Generate with:  openssl rand -hex 32
# Unset → the route returns 503 and the ping does nothing.
CRON_SECRET=

# --- Connected apps: HQ as the OAuth server for apps/hq-mcp ---
# Claude, ChatGPT, Hermes Agent and other MCP clients connect to apps/hq-mcp
# (Railway), which sends them here to sign in and consent. Tokens land in this
# app's Postgres; the server verifies them on every call, against its own
# resource URL.
#
# OAUTH_ISSUER — HQ's public origin: no path, no trailing slash. Must equal
# apps/hq-mcp's MCP_AUTHORIZATION_SERVER byte for byte.
#   OAUTH_ISSUER=https://hq.example.com      (local: http://localhost:8990)
# MCP_RESOURCE_URLS — MCP endpoints HQ issues tokens for, comma-separated. The
# first is the default (clients that don't name one, and personal access
# tokens). Each must equal an MCP server's MCP_PUBLIC_URL, and a server whose
# URL is missing here gets no tokens at all.
#   MCP_RESOURCE_URLS=https://mcp.example.com/mcp
# Unset → /settings/connections says what's missing and the OAuth endpoints answer 503.
# Manage connections and personal access tokens at /settings/connections.
OAUTH_ISSUER=
MCP_RESOURCE_URLS=

# --- Sealing key (Google, provider and LLM keys, runtime delivery) ---
# 32 random bytes, base64 — the SAME value on apps/hq-mcp and apps/agent-runner.
# Seals the Google refresh token, provider and LLM keys, and runtime
# event-signing secrets (AES-256-GCM). Unset → Settings › Google and
# Connections explain what's missing; nothing else needs it.
#   openssl rand -base64 32
HQ_SEALING_KEY=
# CREATOR_SEALING_KEY is the legacy name, read when HQ_SEALING_KEY is unset.
# A deployment that already sealed data under it keeps it there (same value)
# rather than renaming — a different key can't open what was sealed.
# CREATOR_SEALING_KEY=
# Local development only: allow a runtime delivery URL on http://localhost
# (the legacy name CREATOR_RUNTIME_ALLOW_PRIVATE is read too).
# HQ_RUNTIME_ALLOW_PRIVATE=1

# --- Google (Drive storage + Calendar sync) ---
# An OAuth client of type "Web application" in your own Google Cloud project,
# with the Drive and Calendar APIs on and the redirect URI
# <OAUTH_ISSUER>/api/google/callback (Settings › Google shows the exact one).
# Scopes asked: drive.file, calendar.events, calendar.readonly.
# Unset → Settings › Google says what's missing; R2 and everything else work.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- Object storage: Cloudflare R2 (src/lib/storage) ---
# HQ reaches R2 through its S3 API with an R2 API token that has Object Read &
# Write on this one bucket. ACCOUNT_ID is on the R2 overview page; the key pair
# is shown once, when the token is created.
# PUBLIC_URL is optional: a custom domain (or r2.dev URL) serving the bucket.
# Leave it unset to keep objects private and read them via presigned URLs.
# ENDPOINT is optional: it replaces the endpoint built from ACCOUNT_ID, for an
# EU/FedRAMP bucket (https://<account>.eu.r2.cloudflarestorage.com) or a local
# S3-compatible server. Verify everything with `bun run r2:check`.
# Unset → storageReadiness() lists what's missing; storage calls throw a 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_PUBLIC_URL=
# R2_ENDPOINT=
