{
  "name": "hq",
  "version": "2026.09.1801",
  "private": true,
  "description": "TheIceJi HQ — the owner's command center: projects × modules — notes, board, prompts, assets, story, calendar, quotes, publish, market, experiments, readings and agents — on one ops kernel, with connected apps (OAuth server) and account settings.",
  "scripts": {
    "dev": "next dev -p 8990",
    "build": "next build",
    "start": "next start -p 8990",
    "lint": "bunx biome lint --write",
    "check": "bunx biome check --write",
    "verify": "bunx biome ci . && bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:check": "bun run scripts/check-db.ts",
    "db:backup": "bun run scripts/backup.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:studio": "bunx drizzle-kit studio",
    "r2:check": "bun run scripts/check-r2.ts",
    "user:create": "bun run scripts/user.ts create",
    "user:list": "bun run scripts/user.ts list",
    "user:passwd": "bun run scripts/user.ts passwd",
    "user:delete": "bun run scripts/user.ts delete"
  },
  "dependencies": {
    "@theiceji/hq-agents": "workspace:*",
    "@theiceji/hq-assets": "workspace:*",
    "@theiceji/hq-auth": "workspace:*",
    "@theiceji/hq-board": "workspace:*",
    "@theiceji/hq-calendar": "workspace:*",
    "@theiceji/hq-core": "workspace:*",
    "@theiceji/hq-db": "workspace:*",
    "@theiceji/hq-experiments": "workspace:*",
    "@theiceji/hq-market": "workspace:*",
    "@theiceji/hq-ops": "workspace:*",
    "@theiceji/hq-prompts": "workspace:*",
    "@theiceji/hq-publish": "workspace:*",
    "@theiceji/hq-push": "workspace:*",
    "@theiceji/hq-quotes": "workspace:*",
    "@theiceji/hq-readings": "workspace:*",
    "@theiceji/hq-storage": "workspace:*",
    "@theiceji/hq-story": "workspace:*",
    "@theiceji/net-guard": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
