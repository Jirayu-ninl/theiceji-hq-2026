{
  "name": "@theiceji/hq-calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HQ Calendar: the owner’s events and the two-way sync with Google Calendar (incremental read in the ops tick, write-back for events with sync on). Framework-free; on @theiceji/hq-ops and @theiceji/hq-core.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test",
    "verify": "bunx biome ci . && bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@theiceji/hq-core": "workspace:*",
    "@theiceji/hq-db": "workspace:*",
    "@theiceji/hq-ops": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
