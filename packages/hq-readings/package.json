{
  "name": "@theiceji/hq-readings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HQ Readings: no tables of its own — the dashboard and `readings_query` read every module through the hq-core readings registry (posts and listings at an age, money lines) plus generation cost from hq-ops usage events. Framework-free; on @theiceji/hq-ops and @theiceji/hq-core.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test test",
    "verify": "bunx biome ci . && bunx tsc --noEmit",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@theiceji/hq-core": "workspace:*",
    "@theiceji/hq-db": "workspace:*",
    "@theiceji/hq-ops": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@theiceji/hq-board": "workspace:*",
    "@theiceji/hq-market": "workspace:*",
    "@theiceji/hq-publish": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
